<Window x:Class="RegionConfigApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="🌍 Region Configurations" Height="750" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#229954"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Header -->
                <Border Background="#3498DB" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🌍 OpenSim Region Generator" 
                                   FontSize="18" FontWeight="Bold" 
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Erstellen Sie Regionen mit verschiedenen Mustern" 
                                   FontSize="11" Foreground="White" 
                                   HorizontalAlignment="Center" Margin="0,3,0,0" Opacity="0.9"/>
                    </StackPanel>
                </Border>

                <!-- Region Name -->
                <Label Content="📝 Region Name:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtRegionName" Margin="0,0,0,10" ToolTip="{Binding RegionNameTooltip}"/>

                <!-- Region UUID -->
                <Label Content="🔑 Region UUID:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtRegionUuid" Margin="0,0,0,10" ToolTip="{Binding RegionUuidTooltip}"/>

                <!-- Location -->
                <Label Content="📍 Location:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtLocation" Margin="0,0,0,10" ToolTip="{Binding LocationTooltip}"/>

                <!-- Size -->
                <Label Content="📏 Size:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtSize" Margin="0,0,0,10" ToolTip="{Binding SizeTooltip}"/>

                <!-- Internal Port -->
                <Label Content="🔌 Internal Port:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtInternalPort" Margin="0,0,0,10" ToolTip="{Binding InternalPortTooltip}"/>

                <!-- External Host -->
                <Label Content="🌐 External Host:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtExternalHost" Margin="0,0,0,10" ToolTip="{Binding ExternalHostTooltip}"/>

                <!-- Max Prims -->
                <Label Content="🎲 Max Prims:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtMaxPrims" Margin="0,0,0,10" ToolTip="{Binding MaxPrimsTooltip}"/>

                <!-- Max Agents -->
                <Label Content="👥 Max Agents:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtMaxAgents" Margin="0,0,0,10" ToolTip="{Binding MaxAgentsTooltip}"/>

                <!-- Maptile UUID -->
                <Label Content="🗺️ Maptile UUID:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtMaptileUuid" Margin="0,0,0,10" ToolTip="{Binding MaptileUuidTooltip}"/>

                <!-- Internal Address -->
                <Label Content="🏠 Internal Address:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtInternalAddress" Margin="0,0,0,10" ToolTip="{Binding InternalAddressTooltip}"/>

                <!-- Allow Alternate Ports -->
                <CheckBox x:Name="chkAllowAlternatePorts" Content="🔄 Allow Alternate Ports" 
                          Margin="0,0,0,10" ToolTip="{Binding AllowAlternatePortsTooltip}"/>

                <!-- Non-Physical Prim Max -->
                <Label Content="📦 Non-Physical Prim Max:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtNonPhysicalPrimMax" Margin="0,0,0,10" ToolTip="{Binding NonPhysicalPrimMaxTooltip}"/>

                <!-- Physical Prim Max -->
                <Label Content="⚡ Physical Prim Max:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtPhysicalPrimMax" Margin="0,0,0,10" ToolTip="{Binding PhysicalPrimMaxTooltip}"/>

                <!-- Clamp Prim Size -->
                <CheckBox x:Name="chkClampPrimSize" Content="🔒 Clamp Prim Size" 
                          Margin="0,0,0,10" ToolTip="{Binding ClampPrimSizeTooltip}"/>

                <!-- Max Prims Per User -->
                <Label Content="👤 Max Prims Per User:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtMaxPrimsPerUser" Margin="0,0,0,10" ToolTip="{Binding MaxPrimsPerUserTooltip}"/>

                <!-- Scope ID -->
                <Label Content="🎯 Scope ID:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtScopeId" Margin="0,0,0,10" ToolTip="{Binding ScopeIdTooltip}"/>

                <!-- Region Type -->
                <Label Content="🏷️ Region Type:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtRegionType" Margin="0,0,0,10" ToolTip="{Binding RegionTypeTooltip}"/>

                <!-- Render Min Height -->
                <Label Content="📉 Render Min Height:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtRenderMinHeight" Margin="0,0,0,10" ToolTip="{Binding RenderMinHeightTooltip}"/>

                <!-- Render Max Height -->
                <Label Content="📈 Render Max Height:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtRenderMaxHeight" Margin="0,0,0,10" ToolTip="{Binding RenderMaxHeightTooltip}"/>

                <!-- Maptile Static File -->
                <Label Content="🖼️ Maptile Static File:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtMaptileStaticFile" Margin="0,0,0,10" ToolTip="{Binding MaptileStaticFileTooltip}"/>

                <!-- Master Avatar First Name -->
                <Label Content="👨 Master Avatar First Name:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtMasterAvatarFirstName" Margin="0,0,0,10" ToolTip="{Binding MasterAvatarFirstNameTooltip}"/>

                <!-- Master Avatar Last Name -->
                <Label Content="👤 Master Avatar Last Name:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtMasterAvatarLastName" Margin="0,0,0,10" ToolTip="{Binding MasterAvatarLastNameTooltip}"/>

                <!-- Master Avatar Sandbox Password -->
                <Label Content="🔐 Master Avatar Sandbox Password:" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtMasterAvatarSandboxPassword" Margin="0,0,0,10" ToolTip="{Binding MasterAvatarSandboxPasswordTooltip}"/>

                <!-- Spiral Type -->
                <Label Content="🌀 Spiral Type:" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="cmbSpiralType" Margin="0,0,0,10" ToolTip="{Binding SpiralTypeTooltip}"/>

                <!-- Region Count -->
                <Label Content="🔢 Anzahl Regionen zu generieren:" Style="{StaticResource SectionLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox x:Name="txtRegionCount" Width="100" Text="1" 
                             ToolTip="Anzahl der Regionen, die auf einmal generiert werden sollen (1-999)"/>
                    <TextBlock Text=" (1-999)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                </StackPanel>

                <!-- Save Options -->
                <Border Background="#ECF0F1" CornerRadius="5" Padding="10" Margin="0,10,0,10">
                    <StackPanel>
                        <Label Content="💾 Speicheroptionen:" Style="{StaticResource SectionLabel}"/>
                        <CheckBox x:Name="chkSeparateFiles" Content="📄 Einzelne Datei pro Region erstellen" 
                                  Margin="0,5,0,0"
                                  ToolTip="Wenn aktiviert, wird für jede Region eine separate .ini Datei erstellt (dateiname = regionname.ini)"/>
                    </StackPanel>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button x:Name="btnGenerateRegions" Content="✨ Generate Regions" Width="150" Height="40" 
                            Margin="0,0,10,0" Click="BtnGenerateRegions_Click" 
                            Style="{StaticResource PrimaryButton}"
                            ToolTip="Generiert die angegebene Anzahl von Regionen im gewählten Muster"/>
                    <Button x:Name="btnSaveConfig" Content="💾 Save Config" Width="130" Height="40" 
                            Click="BtnSaveConfig_Click"
                            Style="{StaticResource SuccessButton}"
                            ToolTip="Speichert die Konfiguration"/>
                </StackPanel>

                <!-- Region Count Display -->
                <Border Background="#2ECC71" CornerRadius="5" Padding="10" Margin="0,20,0,0">
                    <TextBlock x:Name="txtRegionCountDisplay" FontSize="16" FontWeight="Bold" 
                               TextAlignment="Center" Text="📊 Regions: 0" Foreground="White"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
